{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ES2021",
    "module": "commonjs",
    "esModuleInterop": true,
    "sourceMap": true,
    "strict": false,
    "rootDir": "src",
    "outDir": "compiled",
    "paths": {
      "@client/*": ["./src/client/*"],
      "@common/*": ["./src/common/*"],
      "@server/*": ["./src/server/*"],
      "*": [
        "./node_modules/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/client/views/**/*-static.ts",
    "/dist/**/*",
    "/compiled/**/*"
  ],
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}