{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ES6",
    "lib": ["ES2021", "DOM"],
    "types": ["node"],
    "module": "ES6",
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true,
    "rootDir": "src/client/static",
    "outDir": "compiled/client/static",
    "paths": {
      "@client/*": ["./src/client/*"],
      "@common/*": ["./src/common/*"],
      "@server/*": ["./src/server/*"],
      "*": [
        "./node_modules/*"
      ]
    }
  },
  "include": [
    "src/client/static/**/*"
  ],
  "exclude": [
    "/dist/**/*",
    "/compiled/**/*"
  ]
}